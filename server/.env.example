PORT=5000
# Deployed frontend origin(s). Supports comma-separated domains (e.g., http://localhost:5173,https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/campusconnect?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Optional override for init-admin script)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=your_secure_admin_password_here
